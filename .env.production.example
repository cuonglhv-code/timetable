# Production Environment Variables for Vercel + Supabase
# Copy these to Vercel Dashboard → Project Settings → Environment Variables

# ─── Database (Supabase) ────────────────────────────────────────────────────
# Supabase Transaction connection string (port 6543)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI → Transaction
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# IMPORTANT: Use Transaction mode (6543), NOT Session mode (5432) for serverless
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ─── Encryption ─────────────────────────────────────────────────────────────
# 64-character hex key for encrypting sensitive data (OAuth tokens, service keys)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── NextAuth / Authentication ──────────────────────────────────────────────
# Random secret for session encryption
# Generate: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET=""

# Your production URL (set after first deploy)
# Example: https://my-timetable.vercel.app
AUTH_URL=""

# Google OAuth credentials (for SSO login)
# Create at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Google Calendar Integration ────────────────────────────────────────────
# Service Account email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# Encrypted JSON key (encrypt via: node scripts/encrypt-key.js --input key.json --key $ENCRYPTION_KEY)
GOOGLE_SERVICE_ACCOUNT_KEY_ENCRYPTED=""

# Your Google Workspace domain (e.g., school.edu)
GOOGLE_DELEGATED_DOMAIN=""

# API scopes (usually don't need to change)
GOOGLE_CALENDAR_API_SCOPES="calendar.events,calendar.settings"

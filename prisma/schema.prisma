// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  engineType    = "library"
}

datasource db {
  provider = "sqlite"
}

model Centre {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  rooms     Room[]
  sessions  ClassSession[]
  managers  User[]   @relation("CentreManager")
  openingPlans ClassOpeningPlan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(cuid())
  centreId  String
  centre    Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  isActive  Boolean  @default(true)
  sessions  ClassSession[]
  openingPlans ClassOpeningPlan[]
  
  @@unique([centreId, name])
  @@index([centreId, isActive])
}

model Course {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String
  colorHex      String?
  totalSessions Int?
  sessions      ClassSession[]
  openingPlans  ClassOpeningPlan[]
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  isActive  Boolean  @default(true)
  sessions  ClassSession[]
  user      User?
  openingPlans ClassOpeningPlan[]
}

model ClassSession {
  id        String   @id @default(cuid())
  className String
  
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  
  centreId  String
  centre    Centre   @relation(fields: [centreId], references: [id], onDelete: Restrict)
  
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  
  date      DateTime
  startTime String
  endTime   String
  notes     String?
  seriesId  String?   // groups recurring sessions
  
  sessionNumber   Int?      // e.g., 3 (meaning "Session 3 of N")
  testType        String?   // MINI_TEST | MID_TEST | FINAL_TEST | null
  examDownloadUrl String?   // Link to printable exam papers
  lmsUrl          String?   // Link to online student LMS tests
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, date])
  @@index([teacherId, date])
  @@index([centreId, date])
  @@index([seriesId])
}

enum UserRole {
  CENTRAL_ADMIN
  CENTRE_MANAGER
  ACADEMIC_SUPERVISOR
  TEACHER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  role            UserRole @default(TEACHER)
  centreId        String?
  centre          Centre?  @relation("CentreManager", fields: [centreId], references: [id], onDelete: SetNull)
  teacherId       String?  @unique
  teacher         Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  isActive        Boolean  @default(true)
  lastLogin       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email, isActive])
  @@index([role, isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  action     String   // CREATE | UPDATE | DELETE
  entityType String   // ClassSession | Centre | Teacher | Course | Room | User | ClassOpeningPlan
  entityId   String
  entityName String
  details    String?  // human-readable summary of what changed
  createdAt  DateTime @default(now())

  @@index([entityType, createdAt])
  @@index([userId, createdAt])
}


model ClassOpeningPlan {
  id              String      @id @default(cuid())
  className       String
  
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  centreId        String
  centre          Centre      @relation(fields: [centreId], references: [id], onDelete: Cascade)
  
  teacherId       String?
  teacher         Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  roomId          String?
  room            Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  
  date            DateTime?
  startTime       String?
  endTime         String?
  
  minStudents     Int         @default(15)
  currentStudents Int         @default(0)
  
  status          String      @default("PLANNING") // PLANNING | SUBMITTED
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([centreId])
  @@index([courseId])
  @@index([teacherId])
  @@index([roomId])
}

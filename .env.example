# Environment variables for local development
# Using SQLite for simplicity - no external database server required

DATABASE_URL="file:./dev.db"

# Encryption key for sensitive data (OAuth tokens, service account keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Google Calendar Integration (Service Account + Domain-Wide Delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_KEY_ENCRYPTED=""
GOOGLE_DELEGATED_DOMAIN=""
GOOGLE_CALENDAR_API_SCOPES="calendar.events,calendar.settings"
